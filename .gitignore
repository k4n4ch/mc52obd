.venv/
__pycache__/
*.pyc
work/
.DS_Store

# ── 位置情報を含むデータは一切リポジトリに入れない ────────────
# 個人の移動履歴にあたるため、解析結果（比のクラスタ、閾値、統計）だけを
# results/ に残し、生データは private/ に置いてここで弾く。走行ログは
# private/logs/ に分けてあるが、private/ 直下ごと弾くので効果は同じ。
private/*
!private/README.md

# 例示用に切り出した区間も同じ扱い。速度は法定内に収めてあり日時もずらして
# あるが、緯度経度はそのまま残るため公開はしない。公開するのはスクリーン
# ショットだけにする（tools/cutlog.py と tools/shifttime.py で再生成できる）。
samples/

# 未公開の下書き（みんカラ投稿の文案など）
drafts/
*.gpx
*.kml
*.kmz
*.geojson
*.nmea
*.tcx
*.fit

# 位置情報列を含みうるスマホアプリのエクスポート（Car Scanner 等）
private/*.csv
*_gps.csv
*_gps.json
